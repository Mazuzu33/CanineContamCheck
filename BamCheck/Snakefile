import pandas as pd
import numpy as np

configfile: "config/config.yaml"

# Read in sample csv and extract the sample names, paths, and breeds
sample_df = pd.read_csv(config["samples_csv"])
sample_names = list(sample_df["samplename"])
sample_dict_paths = dict(zip(sample_df["samplename"], sample_df["samplepath"]))
sample_dict_breed = dict(zip(sample_df["samplename"], sample_df["breed"]))

# Get unique breeds from new samples
unique_new_breeds = sample_df["breed"].unique()
# Import tsv file containing PC coordinates from reference panel
ref_df = pd.read_csv("data/verifybamid/resource_files/dog_wgs.n3973.UU_Cfam_GSD_1.0_ROSY.20251223.snps.phased.filter.prune.vcf.gz.V", 
                 sep='\t', 
                 header=None, 
                 names=["Sample Name", "PC1", "PC2", "PC3", "PC4", "PC5", "PC6", "PC7", "PC8", "PC9", "PC10"], 
                 usecols=range(11)
)
# Create a new column identifying the breed of the dog
ref_df["Breed"] = ref_df["Sample Name"].str.split("#").str[0]
# Get unique breeds from reference samples
unique_ref_breeds = ref_df["Breed"].unique()
# Get unique breeds from new samples that are present in reference samples
unique_breeds = unique_new_breeds[np.isin(unique_new_breeds, unique_ref_breeds)]

# Input function to return the corresponding sample path given a sample name
def get_sample_path(wildcards):
    return sample_dict_paths[wildcards.sample]

# Generate sample-specific csv files detailing possible contamination and pc plots for each available breed
rule all:
    input:
        config["contam_csv"],
        expand(config["pc_plot"] + "/pc_{breed}.html", breed=unique_breeds)

# Run verifybamid on each BAM/CRAM
rule verifybamid:
    input:
        bam=get_sample_path
    output:
        selfsm="results/{sample}/{sample}.selfSM",
        ancestry="results/{sample}/{sample}.Ancestry"
    conda:
        "envs/verifybamid.yaml"
    threads: 8
    shell:
        """
        verifybamid2 --SVDPrefix {config[resource_files]} \
        --Reference {config[reference_genome]} \
        --NumPC 3 \
        --BamFile {input.bam} \
        --IncludeChr "chr1, chr2, chr3, chr4, chr5, chr6, chr7, chr8, chr9, chr10, chr11, chr12, chr13, chr14, chr15, chr16, chr17, chr18, chr19, chr20, chr21, chr22, chr23, chr24, chr25, chr26, chr27, chr28, chr29, chr30, chr31, chr32, chr33, chr34, chr35, chr36, chr37, chr38, chr39" \
        --Output results/{wildcards.sample}/{wildcards.sample} \
        --DisableSanityCheck \
        --NumThread {threads}
        """

# Generate a temporary coordinate sorted bam
rule coordinatesortbam:
    input:
        bam=get_sample_path
    output:
        bam_cs=temp("tmp/{sample}/{sample}.cs.bam"),
        bam_cs_ind=temp("tmp/{sample}/{sample}.cs.bam.bai")
    conda:
        "envs/samtools.yaml"
    threads: 1
    params:
        sort_options = lambda wildcards, threads: (
            f"-@ {threads} -m 4G" if threads > 1 else ""
        )
    shell:
        """
        samtools sort {params.sort_options} {input.bam} -o {output.bam_cs} --reference {config[reference_genome]}
        samtools index {output.bam_cs}
        """
    
# Run qualmap bamqc on each coordinate sorted bam
rule qualimap:
    input:
        bam="tmp/{sample}/{sample}.cs.bam"
    resources:
        mem_mb=14000
    threads: 1
    output:
        directory("results/{sample}/{sample}.qualimap")
    wrapper:
        "v7.6.0/bio/qualimap/bamqc"

# Generate a csv detailing all relevant statistics for all bams
rule statscsv:
    input:
        qualimap_dirs = expand("results/{sample}/{sample}.qualimap", sample=sample_names),
        selfsm_txts = expand("results/{sample}/{sample}.selfSM", sample=sample_names)
    output:
        stats_csv=config["stats_csv"]
    run:
        samples_list = []
        percent_aligned_list = []
        mean_coverage_list = []
        freemix_list = []
        for sample_name, qualimap_dir, selfsm_txt in zip(sample_names, input.qualimap_dirs, input.selfsm_txts):
            # Grab the sample name
            samples_list.append(sample_name)
            # Grab percentage of reads aligned and the mean coverage
            with open(qualimap_dir + "/genome_results.txt" , "r") as genome_results:
                for line in genome_results:
                    if "number of mapped reads" in line:  
                        start = line.find("(") + 1
                        end = line.find("%")
                        percent_aligned = float(line[start:end])
                        percent_aligned_list.append(percent_aligned)
                    elif "mean coverageData" in line:
                        start = line.find("=") + 2
                        end = line.find("X")
                        mean_coverage = float(line[start:end])
                        mean_coverage_list.append(mean_coverage)
            # Grab the verifybamid freemix score
            with open(selfsm_txt, "r") as selfsm:
                lines = selfsm.readlines()
                selfsm_values = lines[1].split('\t')
                freemix = float(selfsm_values[6])
                freemix_list.append(freemix)
        # Create a dataframe containing each bam's statistics
        bams_stats = {
            "Sample": samples_list,
            "Percent Aligned": percent_aligned_list,
            "Mean Coverage": mean_coverage_list,
            "Freemix": freemix_list
        }
        stats_df = pd.DataFrame(bams_stats)
        # Write the dataframe to a csv file
        stats_df.to_csv(output.stats_csv, index=False)

# Function to assign warnings for each sample row
def assign_warnings(row):
            warnings = []
            if row["Percent Aligned"] < config["percent_aligned"]:
                warnings.append("LOW PERCENT ALIGNED")
            if row["Mean Coverage"] < config["mean_coverage"]:
                warnings.append("LOW MEAN COVERAGE")
            if row["Freemix"] >= config["freemix"]:
                warnings.append("FREEMIX CONTAMINATION")    
            return "/".join(warnings)

# Generate a csv detailing all contaminated samples and the reason why
rule contamcsv:
    input:
        stats_csv=config["stats_csv"]
    output:
        contam_csv=config["contam_csv"]
    run:
        # Read in stats csv
        warnings_df = pd.read_csv(input.stats_csv)
        # Generate warnings for each sample row
        warnings_df["Warnings"] = warnings_df.apply(assign_warnings, axis=1)
        # Get rid of any rows with no warnings
        warnings_df = warnings_df[warnings_df["Warnings"] != ""]
        # Get rid of columns other than Sample and Warnings
        warnings_df = warnings_df[["Sample","Warnings"]]
        # Write the dataframe to a csv file
        warnings_df.to_csv(output.contam_csv, index=False)

# Aggregate all pc coordinates together
rule aggcoords:
    input: 
        coords=expand("results/{sample}/{sample}.Ancestry", sample=sample_names),
    output:
        pc_csv=config["pc_csv"]
    run:
        coords_data = []
        # For each ancestry file, create a dictionary containing the name, breed, and pc coordinate data
        for file, name in zip(input.coords, sample_names):
            coord_df = pd.read_csv(file, sep='\t')
            coords_data.append({
                "Sample Name": name,
                "Breed": sample_dict_breed[name],
                "PC1": coord_df.loc[0, "IntendedSample"],
                "PC2": coord_df.loc[1, "IntendedSample"],
                "PC3": coord_df.loc[2, "IntendedSample"]
            })
        # Create a new dataframe from all of the dictionaries and write it to a csv file
        coords_df = pd.DataFrame(coords_data)
        coords_df.to_csv(output.pc_csv, index=False)

# Generate pc plots for each breed
rule pcplot:
    input: 
        config["pc_csv"]
    output:
        config["pc_plot"] + "/pc_{breed}.html"
    script:
        "bin/pc_plotter.py"

        

            







