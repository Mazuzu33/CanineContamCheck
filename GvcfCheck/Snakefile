import pandas as pd

configfile: "config/config.yaml"

# Read in sample csv and extract the sample names and paths
sample_df = pd.read_csv(config["samples_csv"])
sample_names = list(sample_df["samplename"])
sample_dict_paths = dict(zip(sample_df["samplename"], sample_df["samplepath"]))

# Input function to return the corresponding sample path given a sample name
def get_sample_path(wildcards):
    return sample_dict_paths[wildcards.sample]

rule all:
    input:
        config["contam_csv"]

# Convert gvcf to a temporary vcf
rule gvcftovcf:
    input:
        gvcf=get_sample_path
    conda:
        "envs/bcftools.yaml"
    output:
        vcf=temp("tmp/{sample}/{sample}.vcf.gz")
    shell:
        """
        bcftools convert --gvcf2vcf \
        --fasta-ref {config[reference_genome]} \
        -Ov {input.gvcf} \
        | awk 'BEGIN {{OFS="\t"}} /^#/ {{print; next}} {{$4 = toupper($4); $5 = toupper($5); print}}' \
        | bcftools view -AA -Oz -o {output.vcf} -
        """
# Filter vcf down to a temporary biallelic snps vcf
rule bialsnps:
    input:
        vcf="tmp/{sample}/{sample}.vcf.gz"
    conda:
        "envs/bcftools.yaml"
    output:
        snps_vcf=temp("tmp/{sample}/{sample}.bial.snps.vcf.gz")
    shell:
        """
        bcftools view -f PASS,. -m2 -M2 -v snps  -i "FORMAT/AD!='.'" -Oz -o {output.snps_vcf} {input.vcf}
        tabix -p vcf {output.snps_vcf}
        """

# Generate temporary biallelic snps vcf tagged with AF
rule aftag:
    input:
        snps_vcf="tmp/{sample}/{sample}.bial.snps.vcf.gz"
    conda:
        "envs/bcftools.yaml"
    output:
        af_vcf=temp("tmp/{sample}/{sample}.bial.snps.AF.vcf.gz")
    shell:
        """
        bcftools annotate -a {config[reference_panel]} \
        -c INFO/AF -Oz -o {output.af_vcf} \
        {input.snps_vcf}
        """

# Run sceVCF on on biallelic snps vcf tagged with AF
rule sceVCF:
    input:
        af_vcf="tmp/{sample}/{sample}.bial.snps.AF.vcf.gz"
    output:
        scevcf_tsv="results/{sample}/{sample}.scevcf.tsv"
    shell:
        """
        bin/sceVCF -o {output.scevcf_tsv} {input.af_vcf}
        """

# Run bcftools stats on vcf
rule bcfstats:
    input: 
        vcf="tmp/{sample}/{sample}.vcf.gz"
    conda: 
        "envs/bcftools.yaml"
    threads: 1
    output:
        stats="results/{sample}/{sample}.stats.txt"
    shell:
        """
        bcftools stats --threads {threads} -s - {input.vcf} > {output.stats}
        """

# Generate a csv detailing all relevant statistics for all vcfs
rule statscsv:
    input:
        stats_txts = expand("results/{sample}/{sample}.stats.txt", sample=sample_names),
        scevcf_tsvs = expand("results/{sample}/{sample}.scevcf.tsv", sample=sample_names)
    output:
        stats_csv=config["stats_csv"]
    run:
        samples_list = []
        indels_list = []
        tstv_list = []
        charr_list = []
        inconsistent_ab_het_rate_list = []
        for sample_name, stats_txt, scevcf_tsv in zip(sample_names, input.stats_txts, input.scevcf_tsvs):
            # Grab the sample name
            samples_list.append(sample_name)
            # Grab the indels and Ts/Tv ratio
            with open(stats_txt, "r") as stats:
                for line in stats:
                    if line.startswith("PSC"):
                        content = line.split()
                        indels = int(content[8])
                        indels_list.append(indels)
                        ts = float(content[6])
                        tv = float(content[7])
                        tstv = ts/tv
                        tstv_list.append(tstv)
            # Grab the CHARR and INCONSISTENT_AB_HET_RATE
            with open(scevcf_tsv, "r") as scevcf:
                lines = scevcf.readlines()
                content = lines[2].split('\t')
                charr = float(content[9])
                charr_list.append(charr)
                inconsistent_ab_het_rate = float(content[12])
                inconsistent_ab_het_rate_list.append(inconsistent_ab_het_rate)
        # Create a dataframe containing each vcf's statistics
        vcfs_stats = {
            "Sample": samples_list,
            "Indels": indels_list,
            "Ts/tv": tstv_list,
            "CHARR": charr_list,
            "INCONSISTENT_AB_HET_RATE": inconsistent_ab_het_rate_list
        }
        vcfs_df = pd.DataFrame(vcfs_stats)
        # Write the dataframe to a csv file
        vcfs_df.to_csv(output.stats_csv, index=False)

# Function to assign warnings for each sample row
def assign_warnings(row):
            warnings = []
            if row["Indels"] < config["min_indels"]:
                warnings.append("LOW INDELS")
            elif row["Indels"] > config["max_indels"]:
                warnings.append("HIGH INDELS")
            if row["Ts/tv"] < config["min_tstv"]:
                warnings.append("LOW TS/TV")
            elif row["Ts/tv"] > config["max_tstv"]:
                warnings.append("HIGH TS/TV")
            if row["CHARR"] >= config["charr"]:
                warnings.append("CHARR CONTAMINATION")
            if row["INCONSISTENT_AB_HET_RATE"] >= config["inconsistent_ab_het_rate"]:
                warnings.append("INCONSISTENT_AB_HET_RATE CONTAMINATION")       
            return ",".join(warnings)

# Generate a csv detailing all contaminated samples and the reason why
rule contamcsv:
    input:
        stats_csv=config["stats_csv"]
    output:
        contam_csv=config["contam_csv"]
    run:
        # Read in stats csv
        warnings_df = pd.read_csv(input.stats_csv)
        # Generate warnings for each sample row
        warnings_df["Warnings"] = warnings_df.apply(assign_warnings, axis=1)
        # Get rid of any rows with no warnings
        warnings_df = warnings_df[warnings_df["Warnings"] != ""]
        # Get rid of columns other than Sample and Warnings
        warnings_df = warnings_df[["Sample","Warnings"]]
        # Write the dataframe to a csv file
        warnings_df.to_csv(output.contam_csv, index=False)